{
  "manifest_version": 3,
  "name": "GhostSplit.gg Chat Theme for Twitch.tv",
  "version": "0.3.6",
  "description": "Restyles twitch.tv chat to match GhostSplit's look. Dark and light themes. Bits and channel-points UI preserved.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": ["*://*.twitch.tv/*"],
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "css": ["content/twitch-chat.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["content/badges.js", "content/toggle.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
